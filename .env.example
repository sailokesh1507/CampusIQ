NODE_ENV=development
PORT=3001
DATABASE_PATH=./data/campusiq.db
DATABASE_DRIVER=sqlite
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=4000
DATABASE_CONNECTION_ATTEMPTS=2
APP_BASE_URL=http://localhost:3001
VITE_API_URL=
DEMO_MODE=true
AUTH_REQUIRED=false
DEMO_ADMIN_EMAIL=faculty@demo.campusiq.local
DEMO_ADMIN_PASSWORD=change-this-demo-password
SESSION_TTL_DAYS=7
# Set POSTGRES_SEED_DEMO=true only for an isolated synthetic Postgres workspace.
POSTGRES_SEED_DEMO=false
# Optional and intentionally unused by the deterministic default:
# AI_INSIGHTS_PROVIDER=
# AI_API_KEY=
