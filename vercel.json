{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "src/index.ts": {
      "runtime": "nodejs24.x",
      "maxDuration": 30,
      "includeFiles": ["node_modules/better-sqlite3/build/Release/*.node"]
    }
  }
}
